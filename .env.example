SECRET_KEY=zmien-mnie-na-cos-losowego

# --- Baza danych ---
# Używane przez docker-compose.yml do postawienia kontenera z Postgresem
# (DATABASE_URL dla appki web jest wtedy budowane automatycznie w compose
# na podstawie tych zmiennych — nie trzeba go tu duplikować).
# Do uruchomienia bez Dockera (np. lokalnie z venv) ustaw DATABASE_URL ręcznie.
POSTGRES_USER=gameplan
POSTGRES_PASSWORD=zmien-mnie-na-cos-losowego
POSTGRES_DB=gameplan
# DATABASE_URL=postgresql+psycopg2://gameplan:gameplan@localhost:5432/gameplan

# --- SSO (LoginHub) ---
# Dokładnie ta sama wartość co SSO_SECRET w .env LoginHub
SSO_SECRET=wklej-tu-ten-sam-sekret-co-w-hubie
# W kontenerze Docker gameplan łączy się z Hubem (wystawionym na hoście na
# porcie 8011) przez host.docker.internal. Jeśli uruchamiasz gameplan bez
# Dockera (systemd, ten sam host co Hub), użyj http://127.0.0.1:8011.
HUB_INTERNAL_URL=http://host.docker.internal:8011
